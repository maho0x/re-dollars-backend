NODE_ENV=development
PORT=13032
PUBLIC_BASE_URL=https://rd.ry.mk

# Main existing Re:Dollars PostgreSQL database. DATABASE_URL wins when present.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bgmchat
DB_PASSWORD=password
DB_DATABASE=bgmchat
# Legacy aliases from the current backend .env are also accepted:
# DB_PASS=password
# DB_NAME=bgmchat

# Optional user search/profile database. Falls back to the main DB when empty.
SEARCH_DATABASE_URL=
SEARCH_DB_HOST=
SEARCH_DB_PORT=
SEARCH_DB_USER=
SEARCH_DB_PASSWORD=
SEARCH_DB_DATABASE=
# Legacy aliases are also accepted:
# SEARCH_DB_PASS=
# SEARCH_DB_NAME=

# Optional remote profile source used to keep the local users/user_profiles
# cache fresh. Legacy REMOTE_SEARCH_DB_* settings from the current backend are
# accepted; leave empty to disable remote profile sync.
REMOTE_SEARCH_DATABASE_URL=
REMOTE_SEARCH_DB_HOST=
REMOTE_SEARCH_DB_PORT=
REMOTE_SEARCH_DB_USER=
REMOTE_SEARCH_DB_PASSWORD=
REMOTE_SEARCH_DB_DATABASE=
# Legacy aliases are also accepted:
# REMOTE_SEARCH_DB_PASS=
# REMOTE_SEARCH_DB_NAME=
SEARCH_SYNC_ENABLED=true
SEARCH_SYNC_INTERVAL_MS=300000
SEARCH_SYNC_INITIAL_DELAY_MS=5000
SEARCH_SYNC_BATCH_SIZE=1000
SEARCH_SYNC_RECENT_LIMIT=200
SEARCH_SYNC_QUERY_TIMEOUT_MS=10000

# Optional database backups. Disabled by default so gray-rollout instances do
# not start dumping the shared DB unexpectedly. Docker Compose mounts
# HOST_BACKUP_DIR at BACKUP_DIR when enabled.
BACKUP_ENABLED=false
HOST_BACKUP_DIR=./backups
BACKUP_DIR=/app/backups
BACKUP_KEEP_DAYS=7
BACKUP_HOUR=4
BACKUP_RUN_ON_START=false
BACKUP_PG_DUMP_BIN=pg_dump
BACKUP_EXCLUDE_TABLE_DATA=auth_tokens
R2_BACKUP_REMOTE=r2:re-dollars
R2_BACKUP_RCLONE_BIN=rclone

# Optional chat-log archive. Exports complete UTC days from messages as
# .jsonl.gz and uploads to R2_BACKUP_REMOTE when set.
CHAT_LOG_BACKUP_ENABLED=false
HOST_CHAT_LOG_BACKUP_DIR=./chat-log-backups
CHAT_LOG_BACKUP_DIR=/app/chat-log-backups
CHAT_LOG_BACKUP_KEEP_DAYS=30
CHAT_LOG_BACKUP_HOUR=4
CHAT_LOG_BACKUP_RUN_ON_START=false
CHAT_LOG_BACKUP_WINDOW_DAYS=1

# Image-host (imghost) PostgreSQL metadata source. When configured, the scraper
# backfills width/height for newly scraped [img] URLs by filename after the
# first message broadcast, so slow imghost queries do not block push delivery. Use either
# IMGHOST_DATABASE_URL or the discrete IMGHOST_DB_* settings.
IMGHOST_DATABASE_URL=
IMGHOST_DB_HOST=
IMGHOST_DB_PORT=5432
IMGHOST_DB_USER=imghost
IMGHOST_DB_PASSWORD=
IMGHOST_DB_DATABASE=imghost
# Legacy aliases are also accepted:
# IMGHOST_DB_PASS=
# IMGHOST_DB_NAME=
IMGHOST_DB_MAX=2
IMGHOST_DB_QUERY_TIMEOUT_MS=2000

# Bangumi OAuth/API
BGM_APP_ID=
BGM_APP_SECRET=
BANGUMI_ACCESS_TOKEN=
BANGUMI_API_TOKEN=
BGM_CALLBACK_URL=https://rd.ry.mk/api/v1/auth/callback
BGM_API_BASE=https://api.bgm.tv/v0
BGM_P1_API_BASE=https://next.bgm.tv/p1
BGM_ORIGIN=https://chii.in
BGM_DOLLARS_PATH=/dollars
BGM_COOKIE_JSON=[]
BGM_USER_AGENT=ReDollarsNext/0.1 (+https://rd.ry.mk)

# rymk-auth unified login. Legacy Bangumi OAuth remains available for old
# callback flows; new userscript login verifies tokens through this service.
AUTH_PUBLIC_URL=https://auth.ry.mk
# Optional internal/origin address for server-to-server session verification,
# used to bypass the Cloudflare challenge in front of AUTH_PUBLIC_URL.
# Falls back to AUTH_PUBLIC_URL when unset. Example: http://10.88.0.2:15017
# AUTH_INTERNAL_URL=
AUTH_CLIENT=re-dollars
AUTH_JWT_SECRET=
AUTH_SESSION_VERIFY_TIMEOUT_MS=1500

# Localhost-only bot automation bridge. BOT_USER_ID enables backend-owned bot
# reactions; BOT_MEMORY_FILE stores global bot memory outside PostgreSQL.
BOT_USER_ID=
BOT_NICKNAME=布莱克·樱·Bangumi娘
BOT_MEMORY_FILE=./MEMORY.md

# CORS origins allowed to call this API from the Bangumi userscript.
CORS_ORIGINS=https://bangumi.tv,https://bgm.tv,https://chii.in
ADMIN_PASSWORD=
COMMUNITY_EMOJI_DIR=
EMOTE_CONFIG_PATH=

# Legacy static media. VIDEOS_PATH should point at the current backend's video
# directory so /videos/* links keep working on the new domain. Relative or old
# host video URLs are normalized to VIDEO_PUBLIC_BASE_URL when returned.
# For Docker Compose, HOST_* is the host path and VIDEOS_PATH/PUBLIC_DIR are
# in-container paths. For direct/PM2 runs, set VIDEOS_PATH to the host path.
HOST_VIDEOS_PATH=./videos
HOST_PUBLIC_DIR=./public
VIDEOS_PATH=/app/videos
PUBLIC_DIR=/app/public
VIDEO_PUBLIC_BASE_URL=https://rd.ry.mk/videos
LEGACY_VIDEO_BASE_URLS=https://bgmchat.ry.mk/videos

# Upload proxy. Point these at the current upload service while migrating.
# Legacy Lsky-compatible image upload endpoint or base URL. If set,
# POST /api/upload proxies images here and returns top-level imageUrl.
# The local rd-imghost-web app exposes:
# - POST /api/upload for images
# - POST /api/upload/batch for image batches
# - POST /api/upload/file for generic files/videos
LSKY_API_URL=
UPLOAD_IMAGE_ENDPOINT=http://127.0.0.1:15016/api/upload
UPLOAD_IMAGE_FIELD=image
UPLOAD_IMAGE_BATCH_ENDPOINT=http://127.0.0.1:15016/api/upload/batch
UPLOAD_IMAGE_BATCH_FIELD=images
UPLOAD_FILE_ENDPOINT=http://127.0.0.1:15016/api/upload/file
UPLOAD_FILE_FIELD=file
UPLOAD_AUTH_HEADER=Authorization
UPLOAD_AUTH_TOKEN=
# Legacy remote_processor shortcut. When set, image uploads use /process,
# file/video uploads use /process-video, and auth defaults to x-api-key.
REMOTE_PROCESSOR_URL=
REMOTE_PROCESSOR_API_KEY=
PROCESSOR_API_KEY=

# Native WS + DB tailer
WS_PATH=/ws
DB_TAIL_ENABLED=true
DB_TAIL_INTERVAL_MS=1500
DB_TAIL_BATCH_SIZE=100

# Native Bangumi Dollars ingest. Leave enabled=false while the legacy backend is
# still the only scraper, then enable it for the new backend cutover.
SCRAPER_ENABLED=false
SCRAPER_INTERVAL_MS=5000
SCRAPER_SAFETY_SWEEP_WINDOW_SEC=120
SCRAPER_SAFETY_SWEEP_EVERY_TICKS=5
